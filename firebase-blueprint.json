{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a platform user (Creator, Brand, or Admin).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["creator", "brand", "admin"] },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "niche": { "type": "string" },
        "followersCount": { "type": "number", "default": 0 },
        "followingCount": { "type": "number", "default": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "A marketing campaign created by a brand.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brandId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "budget": { "type": "string" },
        "totalBudget": { "type": "number" },
        "cpm": { "type": "number" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "in-progress", "review", "completed"] },
        "deliverables": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brandId", "title", "budget", "status"]
    },
    "Application": {
      "title": "Application",
      "description": "A creator's application to a campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "creatorId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "message": { "type": "string" },
        "proposedBudget": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["campaignId", "creatorId", "status"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "User's financial record for earnings and payments.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "balance": { "type": "number" },
        "totalEarned": { "type": "number" },
        "totalSpent": { "type": "number" },
        "currency": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "balance"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "A request to withdraw funds from the wallet.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["upi", "bank"] },
        "details": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "method", "status"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation thread between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual message within a chat.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "content", "type"]
    },
    "Follow": {
      "title": "Follow",
      "description": "A social relationship between users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId"]
    },
    "Poster": {
      "title": "Poster",
      "description": "A promotional banner for the home page slider.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "imageUrl": { "type": "string" },
        "title": { "type": "string" },
        "link": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["imageUrl", "isActive"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Global user profiles" },
    "/users/{userId}/wallet/balance": { "schema": "Wallet", "description": "User wallet details" },
    "/users/{userId}/transactions/{transactionId}": { "schema": "object", "description": "User transaction history" },
    "/campaigns/{campaignId}": { "schema": "Campaign", "description": "Campaign listings" },
    "/applications/{applicationId}": { "schema": "Application", "description": "Global applications collection" },
    "/withdrawals/{withdrawalId}": { "schema": "Withdrawal", "description": "Global withdrawal requests" },
    "/notifications/{notificationId}": { "schema": "object", "description": "System notifications" },
    "/app_config/main": { "schema": "object", "description": "Global platform settings" },
    "/chats/{chatId}": { "schema": "Chat", "description": "Conversations list" },
    "/chats/{chatId}/messages/{messageId}": { "schema": "Message", "description": "Chat messages" },
    "/follows/{followId}": { "schema": "Follow", "description": "User social connections" },
    "/posters/{posterId}": { "schema": "Poster", "description": "Home page slider posters" }
  }
}
