rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'job.rexoagency@gmail.com'; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // --- App Configuration Rules ---
    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['creator', 'brand', 'admin'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('niche' in data) || (data.niche is string && data.niche.size() <= 100));
    }

    // --- User Rules ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin(); 
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && isValidUser(incoming()) && 
                    incoming().role == existing().role && 
                    incoming().email == existing().email) || isAdmin();
      allow delete: if isAdmin();

      // --- Nested Wallet Rules ---
      match /wallet/balance {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isSignedIn(); 
      }

      // --- Nested Withdrawal Rules ---
      match /withdrawals/{withdrawalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
      }

      // --- Nested Transaction Rules ---
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn(); 
      }
    }

    // --- Campaign Validation ---
    function isValidCampaign(data) {
      return data.keys().hasAll(['brandId', 'title', 'budget', 'status']) &&
             data.brandId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.budget is string &&
             (!('totalBudget' in data) || data.totalBudget is number) &&
             (!('cpm' in data) || data.cpm is number) &&
             data.status in ['draft', 'active', 'in-progress', 'review', 'completed', 'pending', 'rejected'];
    }

    // --- Campaign Rules ---
    match /campaigns/{campaignId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && existing().brandId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && existing().brandId == request.auth.uid) || isAdmin();
    }

    // --- Notification Rules ---
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        (resource.data.recipientId == 'admin' && isAdmin())
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        (resource.data.recipientId == 'admin' && isAdmin())
      );
      allow delete: if isAdmin();
    }

    // --- Global Withdrawals for Admin ---
    match /withdrawals/{withdrawalId} {
      allow read: if (isSignedIn() && resource.data.creatorId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && incoming().creatorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Applications Rules (Top-level) ---
    match /applications/{appId} {
      function canReadApp(data) {
        return isSignedIn() && (
          data.creatorId == request.auth.uid ||
          get(/databases/$(database)/documents/campaigns/$(data.campaignId)).data.brandId == request.auth.uid
        );
      }
      
      allow read: if canReadApp(resource.data) || isAdmin();
      allow create: if isSignedIn() && incoming().creatorId == request.auth.uid;
      allow update: if (isSignedIn() && (
        // Creator update
        (existing().creatorId == request.auth.uid && incoming().creatorId == existing().creatorId) ||
        // Brand update (e.g., status)
        (get(/databases/$(database)/documents/campaigns/$(existing().campaignId)).data.brandId == request.auth.uid && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paidAt']))
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Messages Rules ---
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        // Check if user is part of the application (chatId)
        get(/databases/$(database)/documents/applications/$(resource.data.chatId)).data.creatorId == request.auth.uid ||
        get(/databases/$(database)/documents/campaigns/$(get(/databases/$(database)/documents/applications/$(resource.data.chatId)).data.campaignId)).data.brandId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- Global Logs for Admin ---
    match /transactions_log/{logId} {
        allow read, write: if isAdmin();
    }
  }
}
